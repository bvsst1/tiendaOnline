{
  "info": {
    "name": "Tienda Semana 2",
    "description": "Ejecutar con ambos servicios y los datos iniciales de Oracle. Las pruebas crean y eliminan registros propios; conservan los tres usuarios y cinco productos iniciales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "usuariosUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "productosUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "demoPassword",
      "value": "DemoTienda2026!"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "clienteToken",
      "value": ""
    },
    {
      "key": "usuarioId",
      "value": ""
    },
    {
      "key": "productoId",
      "value": ""
    },
    {
      "key": "correoPrueba",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 Login administrador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{usuariosUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@tienda.cl\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.test(\"Token y perfil sin contraseña\", function () { pm.expect(data.token).to.be.a(\"string\"); pm.expect(data.usuario).to.not.have.property(\"passwordHash\"); pm.expect(data.usuario.rol).to.eql(\"ADMINISTRADOR\"); });",
              "pm.collectionVariables.set(\"adminToken\", data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{usuariosUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"cliente@tienda.cl\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set(\"clienteToken\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Listar usuarios",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{usuariosUrl}}/api/usuarios"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Al menos tres usuarios y sin hashes\", function () { const datos=pm.response.json(); pm.expect(datos.length).to.be.at.least(3); datos.forEach(u => pm.expect(u).to.not.have.property(\"passwordHash\")); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Registrar cliente temporal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{usuariosUrl}}/api/auth/registro",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Usuario de prueba\",\n  \"email\": \"{{correoPrueba}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
