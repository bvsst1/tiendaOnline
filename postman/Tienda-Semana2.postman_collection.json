      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"usuarioId\", pm.response.json().id);",
              "pm.test(\"Registro como cliente\", () => pm.expect(pm.response.json().rol).to.eql(\"CLIENTE\"));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"correoPrueba\", \"prueba.\" + Date.now() + \"@tienda.cl\");"
            ]
          }
        }
      ]
    },
